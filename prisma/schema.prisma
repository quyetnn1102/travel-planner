generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TravelStyle {
  RESORT
  FOOD
  SHOPPING
  CHECK_IN
  FAMILY
  BUDGET
  LUXURY
}

enum TimeBlock {
  MORNING
  NOON
  AFTERNOON
  EVENING
}

enum CostCategory {
  FLIGHT
  HOTEL
  FOOD
  LOCAL_TRANSPORT
  TICKET
  SHOPPING
  OTHER
}

enum SharePermission {
  VIEWER
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  name          String?
  avatarUrl     String?   @map("avatar_url")
  emailVerified DateTime? @map("email_verified")
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  accounts Account[]
  sessions Session[]
  trips    Trip[]

  @@map("users")
}

model Trip {
  id           String        @id @default(uuid())
  userId       String        @map("user_id")
  title        String
  destination  String
  startDate    DateTime      @map("start_date") @db.Date
  endDate      DateTime      @map("end_date") @db.Date
  adultCount   Int           @default(1) @map("adult_count")
  childCount   Int           @default(0) @map("child_count")
  budgetAmount Decimal?      @map("budget_amount") @db.Decimal(12, 2)
  currency     String        @default("VND")
  travelStyle  TravelStyle[] @map("travel_style")
  notes        String?
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  itineraryDays  ItineraryDay[]
  costItems      CostItem[]
  checklistItems ChecklistItem[]
  share          TripShare?

  @@index([userId])
  @@index([startDate])
  @@map("trips")
}

model TripTemplate {
  id             String        @id
  title          String
  destination    String
  durationDays   Int           @map("duration_days")
  adultCount     Int           @default(2) @map("adult_count")
  childCount     Int           @default(0) @map("child_count")
  budgetAmount   Decimal?      @map("budget_amount") @db.Decimal(12, 2)
  currency       String        @default("VND")
  travelStyle    TravelStyle[] @map("travel_style")
  summary        String
  suggestedArea  String?       @map("suggested_area")
  coverImageUrl  String?       @map("cover_image_url")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  days           TemplateDay[]
  costItems      TemplateCostItem[]
  checklistItems TemplateChecklistItem[]

  @@index([destination])
  @@map("trip_templates")
}

model TemplateDay {
  id         String   @id
  templateId String   @map("template_id")
  dayNumber  Int      @map("day_number")
  title      String
  summary    String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  template   TripTemplate       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  activities TemplateActivity[]

  @@unique([templateId, dayNumber])
  @@map("template_days")
}

model TemplateActivity {
  id            String    @id
  templateDayId String    @map("template_day_id")
  timeBlock     TimeBlock @map("time_block")
  title         String
  locationName  String?   @map("location_name")
  estimatedCost Decimal?  @map("estimated_cost") @db.Decimal(12, 2)
  notes         String?
  sortOrder     Int       @default(0) @map("sort_order")

  templateDay TemplateDay @relation(fields: [templateDayId], references: [id], onDelete: Cascade)

  @@index([templateDayId, timeBlock, sortOrder])
  @@map("template_activities")
}

model TemplateCostItem {
  id         String       @id
  templateId String       @map("template_id")
  category   CostCategory
  name       String
  amount     Decimal      @db.Decimal(12, 2)
  quantity   Int          @default(1)
  notes      String?

  template TripTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, category])
  @@map("template_cost_items")
}

model TemplateChecklistItem {
  id         String  @id
  templateId String  @map("template_id")
  title      String
  category   String?
  sortOrder  Int     @default(0) @map("sort_order")

  template TripTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, sortOrder])
  @@map("template_checklist_items")
}

model ItineraryDay {
  id        String   @id @default(uuid())
  tripId    String   @map("trip_id")
  dayNumber Int      @map("day_number")
  date      DateTime @db.Date
  title     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  trip       Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  activities Activity[]

  @@unique([tripId, dayNumber])
  @@index([tripId, date])
  @@map("itinerary_days")
}

model Activity {
  id             String    @id @default(uuid())
  itineraryDayId String    @map("itinerary_day_id")
  timeBlock      TimeBlock @map("time_block")
  startTime      DateTime? @map("start_time") @db.Time
  endTime        DateTime? @map("end_time") @db.Time
  title          String
  locationName   String?   @map("location_name")
  address        String?
  estimatedCost  Decimal?  @map("estimated_cost") @db.Decimal(12, 2)
  currency       String    @default("VND")
  notes          String?
  sortOrder      Int       @default(0) @map("sort_order")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  itineraryDay ItineraryDay @relation(fields: [itineraryDayId], references: [id], onDelete: Cascade)

  @@index([itineraryDayId, timeBlock, sortOrder])
  @@map("activities")
}

model CostItem {
  id        String       @id @default(uuid())
  tripId    String       @map("trip_id")
  category  CostCategory
  name      String
  amount    Decimal      @db.Decimal(12, 2)
  currency  String       @default("VND")
  quantity  Int          @default(1)
  notes     String?
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, category])
  @@map("cost_items")
}

model ChecklistItem {
  id        String   @id @default(uuid())
  tripId    String   @map("trip_id")
  title     String
  isDone    Boolean  @default(false) @map("is_done")
  category  String?
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, sortOrder])
  @@map("checklist_items")
}

model TripShare {
  id         String          @id @default(uuid())
  tripId     String          @unique @map("trip_id")
  shareToken String          @unique @map("share_token")
  isEnabled  Boolean         @default(true) @map("is_enabled")
  permission SharePermission @default(VIEWER)
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([shareToken])
  @@map("trip_shares")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}
